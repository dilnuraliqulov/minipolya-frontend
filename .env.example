# Copy to .env.local (git-ignored) and fill in.
# Everything starting with VITE_ is inlined into the public bundle — never put a secret here.

# API host for PRODUCTION builds only. In `npm run dev` the apps call /api on
# their own origin and the Vite dev server proxies it to http://localhost:8080.
VITE_API_URL=http://localhost:8080

# Bot username (without @) for the admin panel's Telegram Login Widget.
VITE_TELEGRAM_BOT_NAME=

# DEVELOPMENT ONLY — signed Telegram initData for a test admin, used by the
# "Dev login" button. Never reaches a production build (`npm run build` checks).
# How to generate it: CLAUDE.md, "Admin dev login".
VITE_DEV_INIT_DATA=
