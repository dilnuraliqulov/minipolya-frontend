# Copy to .env.local (git-ignored) and fill in.
# Everything starting with VITE_ is inlined into the public bundle — never put a secret here.

# API host for PRODUCTION builds only. In `npm run dev` the apps call /api on
# their own origin and the Vite dev server proxies it to http://localhost:8080.
VITE_API_URL=http://localhost:8080

# Mini App invite links: https://t.me/<bot>/<app>?startapp=<param>.
# Both are public names from @BotFather — never the bot TOKEN.
VITE_TELEGRAM_BOT_USERNAME=
VITE_TELEGRAM_APP_NAME=
# Optional: the support account the blocked screen links to (public username, no @).
VITE_TELEGRAM_SUPPORT_USERNAME=

# Yandex Maps JavaScript API v3 key (Mini App maps). Public, but restrict it to our domains
# in the Yandex developer cabinet. Empty, or if Yandex fails to load → Leaflet + OpenStreetMap.
VITE_YANDEX_MAPS_API_KEY=

# DEV ONLY: key for the browser dev sign-in picker (sent as X-Dev-Login-Key).
# Required by the dev-profile backend (R26): it must equal the backend's DEV_LOGIN_KEY
# (16+ characters); missing or wrong, the dev endpoints answer 404. Only read inside
# DEV-only code, so it never reaches a production bundle.
VITE_DEV_LOGIN_KEY=
